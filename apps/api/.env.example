# Supabase (Project Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon o publishable). Se usa con el JWT del usuario para que aplique RLS.
SUPABASE_ANON_KEY=
# Clave secreta service_role. Solo en el servidor. NUNCA en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Orígenes permitidos por CORS (separados por coma)
WEB_ORIGIN=http://localhost:3000

# Embeddings locales (debe producir 384 dimensiones)
EMBEDDING_MODEL=Xenova/multilingual-e5-small

# Descripciones web de familias de producto (Gemini + Google Search; requiere facturación activa)
WEB_ENRICHMENT=true
ENRICH_FIELDS=Familia,Tipo de tejido

# Caché de respuestas del chat, en horas (0 = desactivada)
ANSWER_CACHE_TTL_HOURS=168

# Local: procesa documentos en el mismo proceso, sin Vercel Queues.
# En Vercel se desactiva solo (VERCEL=1).
INGEST_INLINE=true
PORT=3001
