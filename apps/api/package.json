{
  "name": "api",
  "version": "0.5.0",
  "private": true,
  "description": "API NestJS + worker de ingesta (Vercel Functions + Vercel Queues)",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "test": "rimraf .test-dist && tsc -p tsconfig.json --outDir .test-dist && node --test \".test-dist/**/*.spec.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "rimraf": "^6.1.4",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/queue": "^0.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unpdf": "^2.1.0"
  }
}
