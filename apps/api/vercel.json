{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    },
    "api/queues/ingest.js": {
      "maxDuration": 300,
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "document-ingestion" }]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
