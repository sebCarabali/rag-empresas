{
  "name": "rag-empresas",
  "private": true,
  "version": "0.0.0",
  "description": "Plataforma RAG multi-empresa: Next.js + NestJS en Vercel, Supabase (pgvector) y Gemini",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  }
}
